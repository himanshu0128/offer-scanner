generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  picture       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailAccounts EmailAccount[]
}

model EmailAccount {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String    @unique
  provider     String    @default("google") // "google" | "microsoft" | "demo"
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    Int?
  lastScanned  DateTime?
  status       String    @default("active") // "active" | "error" | "scanning"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  offers       Offer[]

  @@index([userId])
}

model Offer {
  id             String       @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  messageId      String       // Provider message ID for deduplication across scans
  merchantName   String
  merchantDomain String?      // e.g. "nike.com"
  merchantLogo   String?      // Logo URL (e.g. Clearbit / Google Favicon / custom)
  title          String       // e.g. "25% Off Sitewide"
  description    String?      @db.Text
  promoCode      String?      // Nullable if offer is a link-activated deal without a code
  category       String       @default("Other") // Fashion, Food & Dining, Tech, Travel, Beauty, Home, Entertainment, Other
  discountValue  String?      // e.g. "25% OFF", "$20 OFF", "BOGO"
  offerUrl       String?      @db.Text
  receivedAt     DateTime
  expiresAt      DateTime?
  isDismissed    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([emailAccountId, messageId])
  @@index([isDismissed])
  @@index([category])
  @@index([merchantName])
  @@index([expiresAt])
}

model ScanLog {
  id               String   @id @default(cuid())
  triggerType      String   // "manual" | "nightly_cron"
  accountsScanned  Int      @default(0)
  emailsProcessed  Int      @default(0)
  offersExtracted  Int      @default(0)
  status           String   // "completed" | "failed"
  errorMessage     String?  @db.Text
  startedAt        DateTime @default(now())
  completedAt      DateTime?
}
